@inject NavigationManager Nm

<header class="site-nav sticky top-0 z-[100]">
    <div class="mx-auto flex h-16 w-full max-w-3xl items-center justify-between gap-3 px-4 sm:max-w-5xl sm:px-6 lg:max-w-6xl lg:px-8">
        <!-- Brand -->
        <div class="min-w-0">
            <a href="" class="group inline-flex min-w-0 items-center gap-2.5">
                <span class="brand-mark shrink-0">
                    <img src="/images/bipinpaul.jpeg" alt="Bipin Paul" class="brand-mark-image"/>
                </span>
                <span class="min-w-0 leading-tight">
                    <span class="block truncate text-sm font-semibold text-foreground transition-colors">@WebsiteKeys.Title</span>
                    <span class="hidden min-[380px]:block truncate text-xs text-foreground-muted">@WebsiteKeys.Username</span>
                </span>
            </a>
        </div>

        <div class="flex shrink-0 items-center gap-1">
            <!-- Primary navigation -->
            <nav class="hidden items-center gap-1 sm:flex" aria-label="Primary">
                @foreach (var item in menuItems.Where(m => !string.IsNullOrEmpty(m.Name)))
                {
                    <NavLink ActiveClass="nav-link-active"
                             class="nav-link"
                             Match="@(item.Link == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)" href="@item.Link">
                        @item.Name
                    </NavLink>
                }
            </nav>

            <span aria-hidden="true" class="mx-2 hidden h-5 w-px sm:block" style="background: var(--color-border)"></span>

            <!-- Secondary actions -->
            <div class="hidden items-center gap-1 sm:flex">
                @foreach (var item in menuItems.Where(m => string.IsNullOrEmpty(m.Name)))
                {
                    <a href="@item.Link" target="_blank" rel="noopener noreferrer"
                       class="nav-icon-link" aria-label="@item.Label" title="@item.Label">
                        <Svg Icon="item.Icon" SizeClasses="w-[18px] h-[18px]"/>
                    </a>
                }
            </div>

            <button type="button" class="nav-icon-link" data-theme-toggle aria-label="Switch to dark theme" title="Switch to dark theme">
                <span class="theme-toggle-icon theme-icon-moon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-[18px] w-[18px] text-current">
                        <path d="M21.752 15.002A9.718 9.718 0 0 1 18 15.75C12.615 15.75 8.25 11.385 8.25 6c0-1.33.266-2.597.748-3.752A9.75 9.75 0 1 0 21.752 15.002Z" />
                    </svg>
                </span>
                <span class="theme-toggle-icon theme-icon-sun" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-[18px] w-[18px] text-current">
                        <path d="M12 2.25a.75.75 0 0 1 .75.75v1.386a.75.75 0 0 1-1.5 0V3a.75.75 0 0 1 .75-.75Zm0 15a5.25 5.25 0 1 0 0-10.5 5.25 5.25 0 0 0 0 10.5Zm0 4.5a.75.75 0 0 1 .75-.75v-1.386a.75.75 0 0 0-1.5 0V21a.75.75 0 0 1 .75.75Zm9-9.75a.75.75 0 0 0-.75-.75h-1.386a.75.75 0 0 0 0 1.5H20.25A.75.75 0 0 0 21 12Zm-15.864-.75a.75.75 0 0 0 0 1.5H3.75a.75.75 0 0 0 0-1.5h1.386Zm12.228 6.978a.75.75 0 0 1 1.06 0l.98.98a.75.75 0 1 1-1.06 1.06l-.98-.98a.75.75 0 0 1 0-1.06ZM6.596 6.596a.75.75 0 0 1 1.06 0l.98.98a.75.75 0 1 1-1.06 1.06l-.98-.98a.75.75 0 0 1 0-1.06Zm12.788 1.04a.75.75 0 0 1 0-1.06l.98-.98a.75.75 0 1 1 1.06 1.06l-.98.98a.75.75 0 0 1-1.06 0ZM7.636 17.404a.75.75 0 0 1 0 1.06l-.98.98a.75.75 0 1 1-1.06-1.06l.98-.98a.75.75 0 0 1 1.06 0Z" />
                    </svg>
                </span>
            </button>

            <!-- Mobile Menu Button -->
            <button id="toggle-button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu" class="nav-icon-link sm:hidden">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 text-current">
                    <path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"></path>
                </svg>
            </button>
        </div>
    </div>
</header>

<!-- Mobile Menu: mirrors the header bar so brand context is kept -->
<div id="mobile-menu" class="mobile-menu-overlay hidden sm:hidden">
    <div class="mx-auto min-h-screen w-full max-w-3xl px-4 sm:max-w-5xl sm:px-6 lg:max-w-6xl lg:px-8">
        <div class="flex h-16 items-center justify-between gap-3">
            <a href="" class="inline-flex min-w-0 items-center gap-2.5" aria-label="Bipin Paul — home">
                <span class="brand-mark shrink-0">
                    <img src="/images/bipinpaul.jpeg" alt="Bipin Paul" class="brand-mark-image"/>
                </span>
                <span class="min-w-0 leading-tight">
                    <span class="block truncate text-sm font-semibold text-foreground">@WebsiteKeys.Title</span>
                    <span class="hidden min-[380px]:block truncate text-xs text-foreground-muted">@WebsiteKeys.Username</span>
                </span>
            </a>
            <button id="close-mobile-menu-button" class="nav-icon-link" aria-label="Close menu">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 text-current">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                </svg>
            </button>
        </div>

        <nav class="mobile-menu-panel mt-6 space-y-1">
            @foreach (var item in menuItems)
            {
                @if (!string.IsNullOrEmpty(item.Name))
                {
                    <div class="py-2">
                        <NavLink ActiveClass="mobile-nav-link-active"
                                 class="mobile-nav-link"
                                 Match="@(item.Link == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                                 href="@item.Link">
                            @item.Name
                        </NavLink>
                    </div>
                }
                else
                {
                    <div class="py-2">
                        <a href="@item.Link" target="_blank" rel="noopener noreferrer"
                           class="inline-flex items-center gap-3 article-meta-link">
                            <Svg Icon="item.Icon" SizeClasses="w-6 h-6"/>
                            <span class="text-lg">@item.Label</span>
                        </a>
                    </div>
                }
            }
        </nav>
    </div>
</div>
<script>
    const setMobileMenu = (open) => {
        const menu = document.querySelector('#mobile-menu');
        const btn = document.querySelector('#toggle-button');
        if (!menu || !btn) return;
        menu.classList.toggle('hidden', !open);
        btn.setAttribute('aria-expanded', open);
        document.body.style.overflow = open ? 'hidden' : '';
    };

    const toggleMobileMenu = () => {
        const menu = document.querySelector('#mobile-menu');
        setMobileMenu(menu.classList.contains('hidden'));
    };

    document.querySelector('#toggle-button').addEventListener('click', toggleMobileMenu);
    document.querySelector('#close-mobile-menu-button').addEventListener('click', () => setMobileMenu(false));
    // Auto-close on navigate (Blazor client-side routing doesn't reload the page)
    document.querySelector('#mobile-menu').addEventListener('click', (event) => {
        if (event.target.closest('a')) setMobileMenu(false);
    });
    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMobileMenu(false);
    });
</script>


@code
{
    List<MenuItem> menuItems =
    [
        new("Home", ""),
        new("Blog", "blog"),
        new("Tags", "tags"),
        new("", WebsiteKeys.GitHubProfile, Svg.Icons.Github, "GitHub"),
        new("", WebsiteKeys.LinkedIn, Svg.Icons.LinkedIn, "LinkedIn"),
        new("", WebsiteKeys.X, Svg.Icons.X, "X")
    ];

    record MenuItem(string Name, string Link, Svg.Icons? Icon = null, string? Label = null);
}
