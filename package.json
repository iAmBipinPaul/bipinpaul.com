{
  "name": "blazor-app",
  "version": "1.0.0",
  "description": "Blazor app with Tailwind CSS",
  "scripts": {
    "build-css": "tailwindcss -i ./wwwroot/app.css -o ./wwwroot/app.min.css --minify",
    "watch-css": "tailwindcss -i ./wwwroot/app.css -o ./wwwroot/app.min.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.5.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3"
  }
}
